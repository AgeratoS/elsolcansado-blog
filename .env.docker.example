# Copy to .env.docker: cp .env.docker.example .env.docker
# WORDPRESS_WEBHOOK_SECRET must match WORDPRESS_WEBHOOK_SECRET in .env.local

# MySQL
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootpassword

# WordPress (auto-install via WP-CLI, no setup wizard)
WORDPRESS_PORT=8080
WORDPRESS_URL=http://localhost:8080
WORDPRESS_TITLE=Elsolcansado Blog
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=changeme
WORDPRESS_ADMIN_EMAIL=admin@localhost
WORDPRESS_DB_HOST=db
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress

# next-revalidate plugin → Next.js /api/revalidate
NEXTJS_URL=http://host.docker.internal:3000
WORDPRESS_WEBHOOK_SECRET=your-secret-key-here
